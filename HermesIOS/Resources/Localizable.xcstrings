    "Lancez le serveur officiel avec son adresse privée Tailscale. Hermès iOS utilise son API directement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the official server on its private Tailscale address. Hermès iOS talks to that API directly."
          }
        }
      }
    },
    "Dans Hermès iOS, entrez http://<IP-Tailscale>:9119. Si vous utilisez Tailscale Serve avec HTTPS, entrez plutôt son adresse https://…ts.net.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Hermès iOS, enter http://<Tailscale-IP>:9119. If you use Tailscale Serve with HTTPS, enter that https://….ts.net address instead."
          }
        }
      }
    },

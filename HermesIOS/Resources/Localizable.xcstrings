      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lighter day"
          }
        }
      }
    },
    "Choisir l’essentiel et laisser un peu de place au reste.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what matters and leave a little room for the rest."
          }
        }
